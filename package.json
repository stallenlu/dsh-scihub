{
  "name": "dsh-scihub",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Sci-Hub PDF fetcher for DeepSeek Harness: the scihub_pdf / scihub_batch model tools resolve DOIs or article URLs through Sci-Hub mirrors, download the paper PDFs and save them into the session workspace.",
  "exports": {
    ".": "./lib/host.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "update-mirrors.mjs",
    "test-smoke.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "scihub",
    "doi",
    "pdf"
  ],
  "license": "MIT"
}
